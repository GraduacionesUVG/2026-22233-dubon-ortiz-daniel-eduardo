# Gimpy API - variables de entorno (ejemplo)
#
# Uso:  cp .env.example .env   y reemplaza los valores de ejemplo.
# El archivo .env contiene credenciales: NO lo subas al repositorio.
# El servidor lo lee desde el directorio donde se ejecuta `go run ./cmd/api`
# (es decir, desde src/); también puedes definir estas variables en el entorno.

# ---------- Requeridas (el servidor no arranca sin ellas) ----------

# API key de Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-tu_api_key_aqui

# Cadena de conexión a PostgreSQL (este ejemplo corresponde al contenedor del README)
DATABASE_URL=postgres://postgres:gimpy@localhost:5432/gimpy?sslmode=disable

# Secreto para firmar los JWT; usa un valor largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=un_secreto_largo_y_aleatorio

# Modelo de Claude a utilizar. Debe definirse: el valor por defecto del código
# (claude-3-5-sonnet-20240620) ya no está disponible en la API de Anthropic.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---------- Opcionales ----------

# API key de YouTube Data API v3. Sin ella, los videos de ejercicios se
# resuelven como un enlace de búsqueda de YouTube.
# YOUTUBE_API_KEY=tu_youtube_api_key

# Zona horaria IANA que define "hoy" para el coach (por defecto America/Guatemala)
# APP_TIMEZONE=America/Guatemala

# Límite de solicitudes por usuario en POST /routine
# (por defecto 0.05 solicitudes/segundo = 3 por minuto, ráfaga de 3)
# RATE_LIMIT_RPS=0.05
# RATE_LIMIT_BURST=3
